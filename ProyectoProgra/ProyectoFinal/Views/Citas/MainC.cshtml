@model IEnumerable<ProyectoFinal.Models.CitaDto>

@{
    ViewBag.Title = "Mis Citas";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="card shadow p-4 mt-4">
    <h2 class="text-primary mb-3 text-center">Gestión de Citas</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }

    <div class="text-end mb-3">
        <a href="@Url.Action("CrearCita", "Citas")" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva Cita
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No tiene citas registradas en el sistema.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-primary text-center">
                    <tr>
                        <th>Doctor</th>
                        <th>Paciente</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.NombreDoctor</td>
                            <td>@c.NombrePaciente</td>
                            <td>@c.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@c.FechaHoraFin.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@c.Motivo</td>
                            <td>
                                @if (c.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger">@c.Estado</span>
                                }
                                else if (c.Estado.Equals("Programada", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success">@c.Estado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@c.Estado</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!c.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("EditarCita", "Citas", new { id = c.IdCita })"
                                           class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>

                                        @using (Html.BeginForm("Cancelar", "Citas", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="IdCita" value="@c.IdCita" />
                                            <button type="submit" class="btn btn-danger btn-sm"
                                                    onclick="return confirm('¿Está seguro de cancelar esta cita?');">
                                                <i class="bi bi-x-circle"></i> Cancelar
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Sin acciones disponibles.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<hr class="mt-4" />

<div class="text-muted small text-center">
    @{
        var total = Model != null ? Model.Count() : 0;
        var activas = Model != null ? Model.Count(c => !string.Equals(c.Estado, "Cancelada", StringComparison.OrdinalIgnoreCase)) : 0;
    }

    <p>Total de citas registradas: <strong>@total</strong></p>
    <p>Citas activas: <strong>@activas</strong></p>
</div>
