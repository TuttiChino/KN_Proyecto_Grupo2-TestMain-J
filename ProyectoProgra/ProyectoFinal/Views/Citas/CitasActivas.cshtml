@model IEnumerable<ProyectoFinal.Models.CitaDto>
@{
    ViewBag.Title = "Mis Citas Activas";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml"; // o tu layout correspondiente
}

<div class="card shadow p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary m-0">Citas Activas</h2>
        <div>
            <a href="@Url.Action("MainC","Citas")" class="btn btn-outline-secondary me-2">Ver todas</a>
            <a href="@Url.Action("CrearCita","Citas")" class="btn btn-success">+ Agendar</a>
        </div>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Doctor</th>
                <th>Paciente</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th style="width:170px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var c in Model)
                {
                    <tr>
                        <td>@c.NombreDoctor</td>
                        <td>@c.NombrePaciente</td>
                        <td>@c.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@c.FechaHoraFin.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@c.Motivo</td>
                        <td>
                            @if (string.Equals(c.Estado, "Programada", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">Programada</span>
                            }
                            else
                            {
                                <span class="badge bg-info">@c.Estado</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("EditarCita", "Citas", new { id = c.IdCita })" class="btn btn-warning btn-sm me-2">Editar</a>
                            @using (Html.BeginForm("Cancelar", "Citas", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="IdCita" value="@c.IdCita" />
                                <input type="hidden" name="MotivoCancelacion" value="Cancelada por el paciente." />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('¿Seguro que deseas cancelar esta cita?');">
                                    Cancelar
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No tienes citas activas.</td>
                </tr>
            }
        </tbody>
    </table>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger mt-3" })
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3 text-center">@TempData["Success"]</div>
    }
</div>
