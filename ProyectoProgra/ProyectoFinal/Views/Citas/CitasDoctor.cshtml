@model IEnumerable<ProyectoFinal.Models.CitaDto>

@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Citas Próximas | Doctor";

    var lista = Model ?? new List<ProyectoFinal.Models.CitaDto>();

    // Solo citas programadas que sean futuras
    var proximas = lista
        .Where(c =>
            c.Estado != null &&
            c.Estado.Equals("Programada", StringComparison.OrdinalIgnoreCase) &&
            c.FechaHoraInicio >= DateTime.Now)
        .OrderBy(c => c.FechaHoraInicio)
        .ToList();
}

<div class="card shadow p-4 mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary m-0">
            <i class="bi bi-clock-history me-2"></i> Citas Próximas
        </h2>

        <a href="@Url.Action("LandingDoctor","Home")"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    @if (!proximas.Any())
    {
        <div class="alert alert-info text-center">
            No tiene citas programadas próximamente.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-primary text-center">
                    <tr>
                        <th>Fecha</th>
                        <th>Paciente</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in proximas)
                    {
                        <tr>
                            <td>@c.FechaHoraInicio.ToString("dd/MM/yyyy")</td>
                            <td>@c.NombrePaciente</td>
                            <td>@c.FechaHoraInicio.ToString("HH:mm")</td>
                            <td>@c.FechaHoraFin.ToString("HH:mm")</td>
                            <td>@c.Motivo</td>
                            <td>
                                <span class="badge bg-success">Programada</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-muted text-center small mt-3">
            Total de citas próximas: <strong>@proximas.Count</strong>
        </div>
    }
</div>
