@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Inicio | Paciente";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-heart-pulse-fill me-2"></i>Bienvenido al Portal del Paciente
        </h2>
        <p class="text-muted fs-5">
            Desde aquí puede gestionar sus citas médicas de forma fácil y rápida.
        </p>
    </div>

    <div class="row justify-content-center g-4">
        <!-- Mis Citas -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-check display-4 text-success mb-3"></i>
                    <h5 class="card-title fw-bold mb-3">Mis Citas</h5>
                    <p class="text-muted mb-4">Revise sus citas activas, pendientes o pasadas.</p>
                    <a href="@Url.Action("CitasActivas", "Citas")" class="btn btn-outline-success w-100">
                        <i class="bi bi-eye"></i> Ver Citas
                    </a>
                </div>
            </div>
        </div>

        <!-- Agendar Cita -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-plus-circle display-4 text-primary mb-3"></i>
                    <h5 class="card-title fw-bold mb-3">Agendar Cita</h5>
                    <p class="text-muted mb-4">Seleccione fecha, médico y motivo de su próxima consulta.</p>
                    <a href="@Url.Action("CrearCita", "Citas")" class="btn btn-primary w-100">
                        <i class="bi bi-plus-lg"></i> Agendar Nueva
                    </a>
                </div>
            </div>
        </div>

        <!-- Perfil (opcional) -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle display-4 text-info mb-3"></i>
                    <h5 class="card-title fw-bold mb-3">Mi Perfil</h5>
                    <p class="text-muted mb-4">Actualice su información personal y datos de contacto.</p>
                    <a href="@Url.Action("Perfil", "Paciente")" class="btn btn-outline-info w-100 disabled">
                        <i class="bi bi-pencil"></i> Próximamente
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
