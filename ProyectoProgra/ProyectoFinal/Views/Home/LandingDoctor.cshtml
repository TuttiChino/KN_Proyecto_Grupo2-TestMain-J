@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Inicio | Doctor";
    var nombre = (Session["NombreUsuario"] as string) ?? "Doctor";
}

<style>
    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        font-size: 1.4rem;
        color: #fff;
    }
</style>

<div class="container mt-4">

    <!-- Encabezado -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:52px;height:52px;">
                <i class="bi bi-stethoscope" style="font-size:1.4rem;"></i>
            </div>
            <div>
                <h2 class="m-0">Bienvenido, Dr. @nombre</h2>
                <div class="text-muted">Panel de control y agenda</div>
            </div>
        </div>

        <div class="text-end">
            <div class="fw-semibold">Hoy</div>
            <div id="fecha-hoy" class="text-muted"></div>
        </div>
    </div>

    <!-- Acciones rápidas -->
    <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3 mb-4">

        <!-- Mi agenda -->
        <div class="col d-flex">
            <div class="card shadow-sm border-0 flex-fill h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="icon-box d-flex align-items-center justify-content-center" style="background:#3B82F6;">
                            <i class="bi bi-calendar-week"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="card-title m-0">Mi agenda</h5>
                            <small class="text-muted">Ver todas mis citas</small>
                        </div>
                    </div>

                    <p class="mb-3">
                        Consulta tu agenda completa, filtra por fecha y administra cada cita.
                    </p>

                    <div class="mt-auto">
                        <a href="@Url.Action("Index","Doctor")" class="btn btn-primary w-100">
                            Ver agenda
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Citas próximas -->
        <div class="col d-flex">
            <div class="card shadow-sm border-0 flex-fill h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="icon-box d-flex align-items-center justify-content-center" style="background:#22C55E;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="card-title m-0">Citas próximas</h5>
                            <small class="text-muted">Ver las citas próximas</small>
                        </div>
                    </div>

                    <p class="mb-3">
                        Accede rápidamente a las citas programadas para fechas próximas.
                    </p>

                    <div class="mt-auto">
                        <a href="@Url.Action("CitasDoctor","Citas", new { hoy = 1 })" class="btn btn-success w-100">
                            Ver próximas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nueva cita -->
        <div class="col d-flex">
            <div class="card shadow-sm border-0 flex-fill h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="icon-box d-flex align-items-center justify-content-center" style="background:#FACC15; color:#111;">
                            <i class="bi bi-plus-circle"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="card-title m-0">Nueva cita</h5>
                            <small class="text-muted">Agendar una nueva atención</small>
                        </div>
                    </div>

                    <p class="mb-3">
                        Crea una cita indicando paciente, rango horario y motivo.
                    </p>

                    <div class="mt-auto">
                        <a href="@Url.Action("NuevaCita","Doctor")" class="btn btn-warning w-100">
                            Agendar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mi Perfil -->
        <div class="col d-flex">
            <div class="card shadow-sm border-0 flex-fill h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="icon-box d-flex align-items-center justify-content-center" style="background:#06B6D4;">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="card-title m-0">Mi Perfil</h5>
                            <small class="text-muted">Datos personales y contraseña</small>
                        </div>
                    </div>

                    <p class="mb-3">
                        Actualice su información personal y cambie su contraseña.
                    </p>

                    <div class="mt-auto">
                        <a href="@Url.Action("Perfil","Citas")" class="btn btn-outline-info w-100">
                            <i class="bi bi-key"></i> Gestionar Perfil
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    (function () {
        var el = document.getElementById('fecha-hoy');
        if (el) {
            var f = new Date();
            var opciones = { year: 'numeric', month: 'long', day: 'numeric' };
            try {
                el.innerText = f.toLocaleDateString('es-ES', opciones);
            } catch (e) {
                el.innerText = f.toDateString();
            }
        }
    })();
</script>
