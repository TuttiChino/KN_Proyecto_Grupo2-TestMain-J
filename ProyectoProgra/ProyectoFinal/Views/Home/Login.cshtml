
@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div id="auth">
    <div class="row h-100">
        <div class="col-lg-5 col-12">
            <div id="auth-left">
                <div class="auth-logo">
                    <a href="@Url.Action("Index","Home")"><img src="~/StaticFiles/img/logo.png" alt="Logo"></a>
                </div>
                <h1 class="auth-title">Iniciar sesión</h1>
                <p class="auth-subtitle mb-3">Inicie sesión con su correo y contraseña.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                @using (Html.BeginForm("Index", "Home", FormMethod.Post, new { @class = "mt-3" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group position-relative has-icon-left mb-4">
                        <input type="email" name="correo" class="form-control form-control-xl" placeholder="Correo" required />
                        <div class="form-control-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                    </div>

                    <div class="form-group position-relative has-icon-left mb-4">
                        <input type="password" name="contrasenna" class="form-control form-control-xl" placeholder="Contraseña" required />
                        <div class="form-control-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                    </div>

                    <div class="form-check form-check-lg d-flex align-items-end">
                        <input class="form-check-input me-2" type="checkbox" id="keep" />
                        <label class="form-check-label text-gray-600" for="keep">Mantener la sesión iniciada</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-lg mt-4">Iniciar sesión</button>
                }

                <div class="text-center mt-4 text-lg fs-4">
                    <p class="text-gray-600">
                        ¿Aún no tienes una cuenta?
                        <a href="@Url.Action("Register","Home")" class="font-bold">Regístrate</a>.
                    </p>
                    <p><a class="font-bold" href="@Url.Action("RecuperarAcceso","Home")">¿Olvidaste tu contraseña?</a></p>
                </div>
            </div>
        </div>
        <div class="col-lg-7 d-none d-lg-block">
            <div id="auth-right"></div>
        </div>
    </div>
</div>


