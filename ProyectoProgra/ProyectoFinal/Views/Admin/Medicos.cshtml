@model IEnumerable<ProyectoFinal.Models.MedicoDto>

@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Administración de Médicos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary mb-0">Médicos</h2>
            <span class="text-muted">Gestione los usuarios con perfil médico</span>
        </div>
        <div>
            <a href="@Url.Action("CrearMedico", "Admin")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo médico
            </a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay médicos registrados en el sistema.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Identificación</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model)
                            {
                                <tr>
                                    <td>@m.Identificacion</td>
                                    <td>@m.Nombre</td>
                                    <td>@m.CorreoElectronico</td>
                                    <td class="text-center">
                                        @if (m.Estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("EditarMedico", "Admin", new { id = m.ConsecutivoMedico })"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>

                                            @using (Html.BeginForm("EliminarMedico", "Admin", FormMethod.Post, new { onsubmit = "return confirm('¿Seguro que desea eliminar este médico?');" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", m.ConsecutivoMedico)
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-muted small mt-2">
                    Total de médicos: <strong>@Model.Count()</strong>
                </div>
            </div>
        </div>
    }
</div>
