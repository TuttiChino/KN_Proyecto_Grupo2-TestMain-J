@model ProyectoFinal.Models.ReporteResumenVM

@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Reportes | Admin";
}

<h2 class="mb-4">Reportes del Sistema</h2>

<form method="get" class="row mb-4">
    <div class="col-md-4">
        <label>Fecha inicio</label>
        <input type="date"
               name="fechaInicio"
               class="form-control"
               value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-4">
        <label>Fecha fin</label>
        <input type="date"
               name="fechaFin"
               class="form-control"
               value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            Filtrar
        </button>
    </div>
</form>

<div class="row text-center">
    <div class="col-md-3">
        <div class="card p-3">
            Total Citas<br />
            <strong>@Model.TotalCitas</strong>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Programadas<br />
            <strong>@Model.CitasProgramadas</strong>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Completadas<br />
            <strong>@Model.CitasCompletadas</strong>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Canceladas<br />
            <strong>@Model.CitasCanceladas</strong>
        </div>
    </div>
</div>

<hr />

<div class="row mt-5">
    <div class="col-md-8 mx-auto">
        <div class="card p-4">
            <h5 class="text-center mb-3">Citas por estado</h5>
            <canvas id="citasChart"></canvas>
        </div>
    </div>
</div>


<div class="row text-center mt-3">
    <div class="col-md-6">
        <div class="card p-3">
            Médicos activos<br />
            <strong>@Model.TotalMedicos</strong>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            Pacientes activos<br />
            <strong>@Model.TotalPacientes</strong>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    const ctx = document.getElementById('citasChart');

    const chart = new Chart(ctx, {
        type: 'bar', // puedes cambiar a 'pie' si quieres
        data: {
            labels: ['Programadas', 'Completadas', 'Canceladas'],
            datasets: [{
                label: 'Cantidad de citas',
                data: [
                    @Model.CitasProgramadas,
                    @Model.CitasCompletadas,
                    @Model.CitasCanceladas
                ],
                backgroundColor: [
                    'rgba(255, 193, 7, 0.7)',   // amarilla
                    'rgba(40, 167, 69, 0.7)',   // verde
                    'rgba(220, 53, 69, 0.7)'    // rojo
                ],
                borderColor: [
                    'rgba(255, 193, 7, 1)',
                    'rgba(40, 167, 69, 1)',
                    'rgba(220, 53, 69, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
    </script>
}

