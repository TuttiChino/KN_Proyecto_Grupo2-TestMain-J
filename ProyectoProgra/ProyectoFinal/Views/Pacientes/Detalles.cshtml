@model ProyectoFinal.EF.tbUsuario

@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Detalles del Paciente | Admin";
    var citas = ViewBag.Citas as IEnumerable<ProyectoFinal.EF.tbCita>;
    var totalCitas = ViewBag.TotalCitas as int? ?? 0;
    var citasProgramadas = ViewBag.CitasProgramadas as int? ?? 0;
    var citasCompletadas = ViewBag.CitasCompletadas as int? ?? 0;
    var citasCanceladas = ViewBag.CitasCanceladas as int? ?? 0;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>Detalles del Paciente</h2>
        </div>
        <div class="col-md-6 text-right">
            <a href="@Url.Action("Editar", "Pacientes", new { id = Model.ConsecutivoUsuario })" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Editar
            </a>
            <a href="@Url.Action("Index", "Pacientes")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Información del Paciente -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person"></i> Informaci&oacute;n Personal</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Identificaci&oacute;n:</dt>
                        <dd class="col-sm-8">@Model.Identificacion</dd>

                        <dt class="col-sm-4">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4">Correo Electr&oacute;nico:</dt>
                        <dd class="col-sm-8">@Model.CorreoElectronico</dd>

                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Estado)
                            {
                                <span class="badge badge-secondary" style="background-color: #e9ecef; color: #000000;">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-danger" style="background-color: #f8d7da; color: #721c24;">Inactivo</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Estadísticas de Citas -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Estadísticas de Citas</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="border rounded p-3">
                                <h3 class="text-primary mb-0">@totalCitas</h3>
                                <small class="text-muted">Total</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="border rounded p-3">
                                <h3 class="text-success mb-0">@citasCompletadas</h3>
                                <small class="text-muted">Completadas</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <h3 class="text-warning mb-0">@citasProgramadas</h3>
                                <small class="text-muted">Programadas</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <h3 class="text-danger mb-0">@citasCanceladas</h3>
                                <small class="text-muted">Canceladas</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Historial de Citas -->
    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Historial de Citas</h5>
        </div>
        <div class="card-body">
            @if (citas != null && citas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>M&eacute;dico</th>
                                <th>Estado</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in citas)
                            {
                                <tr>
                                    <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@cita.HoraInicio.ToString(@"hh\:mm") - @cita.HoraFin.ToString(@"hh\:mm")</td>
                                    <td>@(cita.tbMedico?.Nombre ?? "N/A")</td>
                                    <td>
                                        @switch (cita.Estado)
                                        {
                                            case "Programada":
                                                <span class="badge badge-warning">@cita.Estado</span>
                                                break;
                                            case "Reprogramada":
                                                <span class="badge badge-info">@cita.Estado</span>
                                                break;
                                            case "Completada":
                                                <span class="badge badge-success">@cita.Estado</span>
                                                break;
                                            case "Cancelada":
                                                <span class="badge badge-danger">@cita.Estado</span>
                                                break;
                                            default:
                                                <span class="badge badge-secondary">@cita.Estado</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(cita.Observaciones))
                                        {
                                            <span title="@cita.Observaciones">
                                                @(cita.Observaciones.Length > 50 ? cita.Observaciones.Substring(0, 50) + "..." : cita.Observaciones)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Este paciente no tiene citas registradas.
                </div>
            }
        </div>
    </div>
</div>

