@model IEnumerable<ProyectoFinal.EF.tbUsuario>

@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Pacientes | Admin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gesti&oacute;n de Pacientes</h2>
        <a href="@Url.Action("Crear", "Pacientes")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Paciente
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Búsqueda -->
    <div class="card mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Pacientes", FormMethod.Get, new { @class = "row" }))
            {
                <div class="col-md-10 mb-2 mb-md-0">
                    <input type="text" name="buscar" class="form-control" placeholder="Buscar por nombre, identificaci&oacute;n o correo..." value="@ViewBag.Buscar" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary btn-block">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Tabla de pacientes -->
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Identificaci&oacute;n</th>
                                <th>Nombre</th>
                                <th>Correo Electr&oacute;nico</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var paciente in Model)
                            {
                                <tr>
                                    <td>@paciente.Identificacion</td>
                                    <td>@paciente.Nombre</td>
                                    <td>@paciente.CorreoElectronico</td>
                                    <td>
                                        @if (paciente.Estado)
                                        {
                                            <span class="badge badge-secondary" style="background-color: #e9ecef; color: #000000;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger" style="background-color: #f8d7da; color: #721c24;">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Detalles", "Pacientes", new { id = paciente.ConsecutivoUsuario })" 
                                               class="btn btn-sm btn-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Editar", "Pacientes", new { id = paciente.ConsecutivoUsuario })" 
                                               class="btn btn-sm btn-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <small class="text-muted">Total de pacientes: @Model.Count()</small>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No se encontraron pacientes.
                    @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
                    {
                        <span>Intenta con otros criterios de búsqueda.</span>
                    }
                    else
                    {
                        <span>@Html.ActionLink("Crear el primer paciente", "Crear", "Pacientes")</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

