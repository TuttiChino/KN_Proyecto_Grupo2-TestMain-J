@model ProyectoFinal.EF.tbCita
@{
    ViewBag.Title = "Nueva Cita";
}

<h2>Agendar Nueva Cita</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm("NuevaCita", "Doctor", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Paciente</label>
        @Html.DropDownListFor(m => m.ConsecutivoPaciente, (SelectList)ViewBag.Pacientes, "Seleccione un paciente", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Fecha</label>
        @Html.TextBoxFor(m => m.Fecha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        <label>Hora Inicio</label>
        @Html.TextBoxFor(m => m.HoraInicio, new { @class = "form-control", type = "time" })
    </div>

    <div class="form-group">
        <label>Hora Fin</label>
        @Html.TextBoxFor(m => m.HoraFin, new { @class = "form-control", type = "time" })
    </div>

    <div class="form-group">
        <label>Observaciones</label>
        @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Exito"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

<script>
    document.querySelector("form").addEventListener("submit", function (e) {
        var inicio = document.querySelector("[name='HoraInicio']").value;
        var fin = document.querySelector("[name='HoraFin']").value;
        if (inicio >= fin) {
            alert("⚠️ La hora de fin debe ser mayor que la hora de inicio.");
            e.preventDefault();
        }
    });
</script>